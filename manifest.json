{
  "manifest_version": 3,
  "name": "LumaBorder",
  "description": "Dinamik ve sinematik glow efektiyle videoları ekranınızın dışına taşıyın.",
  "version": "3.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "LumaBorder",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "exclude_matches": [
        "https://www.youtube.com/live_chat*",
        "https://youtube.com/live_chat*"
      ],
      "all_frames": false,
      "css": [
        "src/styles/ambient.css",
        "src/styles/menu.css"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab"
  ],
  "commands": {
    "toggle-ambient": {
      "suggested_key": {
        "default": "Alt+A",
        "mac": "Alt+A"
      },
      "description": "Işık Efektini Aç/Kapat"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "src/styles/*",
        "src/render-worker.js"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "use_dynamic_url": true
    }
  ]
}
